# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-key>

# Server-side only. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Comma-separated admin emails allowed privileged writes.
ADMIN_EMAILS=admin@example.com

# Shared secret for calling the send-push Edge Function. Must match the
# PUSH_SECRET function secret and private.push_config.push_secret in the DB.
# Server-side only. Never prefix with NEXT_PUBLIC.
PUSH_SECRET=<random-long-secret>

